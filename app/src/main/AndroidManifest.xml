<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MANAGE_EXTERNAL_STORAGE is what lets Rust walk real paths like
      /storage/emulated/0 directly. The user grants it in Settings, not with a
      normal permission dialog - see StoragePermission.kt.

      Google Play restricts this permission to apps whose core function
      requires it (a file manager qualifies, but needs a declaration form).
      Sideloading is unaffected.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      Network storage talks to FTP, SFTP, SMB and WebDAV servers, and the
      built-in server listens for them - both need a socket.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The FTP server keeps running while the app is in the background, which is
      the whole point of it: the phone sits on the desk serving files while the
      user works on the laptop. Android only allows that for a foreground
      service, and only one whose type is declared. DATA_SYNC is the documented
      category for transferring files, and is required from API 34.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      A foreground service must show a notification, and from API 33 posting one
      needs the user's agreement. Declined, the server still runs - Android
      keeps the service alive either way - but nothing appears in the shade to
      say so or to stop it.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      READ_MEDIA_IMAGES / VIDEO / AUDIO are still deliberately absent. They were
      here as a fallback for when all-files access is declined, but no such
      fallback was ever built - the app gates every screen on
      MANAGE_EXTERNAL_STORAGE and never requests them.

      Asking for permissions the code never uses is worth avoiding on its own,
      and these are exactly the sensitive ones that draw extra scrutiny from
      Play Protect and store review. Add each back in the same commit as the
      code that needs it.
    -->

    <application
        android:name=".FileManagerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FileManager"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FileManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Lets us hand a file to another app (share, open-with) without
          exposing a file:// URI, which Android has banned since Nougat.
        -->
        <!--
          Not exported: nothing outside the app may start the server. It is
          started from its own screen and stopped from its notification, and an
          exported service would let any app on the device open the user's
          storage to the network.
        -->
        <service
            android:name=".data.ftpd.FtpService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
