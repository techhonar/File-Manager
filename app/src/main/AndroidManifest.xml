        <!--
          Lets us hand a file to another app (share, open-with) without
          exposing a file:// URI, which Android has banned since Nougat.
        -->
        <!--
          Not exported: nothing outside the app may start the server. It is
          started from its own screen and stopped from its notification, and an
          exported service would let any app on the device open the user's
          storage to the network.
        -->
        <service
            android:name=".data.ftpd.FtpService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Where the installer reports back on a split-APK bundle this app
          handed it: first to ask for the user's confirmation, then with the
          outcome. Only the installer reaches it, through a pending intent.
        -->
        <receiver
            android:name=".data.install.InstallResultReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
