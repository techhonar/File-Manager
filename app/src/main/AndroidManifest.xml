<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MANAGE_EXTERNAL_STORAGE is what lets Rust walk real paths like
      /storage/emulated/0 directly. The user grants it in Settings, not with a
      normal permission dialog - see StoragePermission.kt.

      Google Play restricts this permission to apps whose core function
      requires it (a file manager qualifies, but needs a declaration form).
      Sideloading is unaffected.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      Network storage talks to FTP, SFTP, SMB and WebDAV servers, and the
      built-in server listens for them - both need a socket.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The FTP server keeps running while the app is in the background, which is
      the whole point of it: the phone sits on the desk serving files while the
      user works on the laptop. Android only allows that for a foreground
      service, and only one whose type is declared. DATA_SYNC is the documented
      category for transferring files, and is required from API 34.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      A foreground service must show a notification, and from API 33 posting one
      needs the user's agreement. Declined, the server still runs - Android
      keeps the service alive either way - but nothing appears in the shade to
      say so or to stop it.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Tapping an .apk hands it to the system installer, which from Android 8
      checks the app it came from: one that targets 8 or later without this
      declared is turned away, and the installer closes the moment it opens,
      with no message - so tapping an .apk did nothing at all. Declared, the
      installer asks the user once to allow installs from this app, then
      installs. It grants nothing on its own; that switch is the user's.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      READ_MEDIA_IMAGES / VIDEO / AUDIO are still deliberately absent. They were
      here as a fallback for when all-files access is declined, but no such
      fallback was ever built - the app gates every screen on
      MANAGE_EXTERNAL_STORAGE and never requests them.

      Asking for permissions the code never uses is worth avoiding on its own,
      and these are exactly the sensitive ones that draw extra scrutiny from
      Play Protect and store review. Add each back in the same commit as the
      code that needs it.
    -->

    <!--
      The other apps that open downloads, folders and documents, so the
      Default apps screen can say which one does. Since Android 11 an app
      sees only the others it names a reason to look for.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW_DOWNLOADS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="resource/folder" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:scheme="content"
                android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
        </intent>
    </queries>

    <application
        android:name=".FileManagerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FileManager"
        tools:targetApi="33">

        <!--
          No launcher entry of its own: the app is opened through whichever
          activity-alias below is turned on, one per logo under Theme > App
          logo. Exactly one is on at a time; logo 1, the original, to start.

          What it does declare is what makes Android count it as a file
          manager. There is no setting for a default one: when something asks
          for a files app, a folder or a file, the phone offers every app
          that says it can, and the user picks one with "Always". These stay
          here rather than on the aliases, which come and go with the logo.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FileManager"
            android:windowSoftInputMode="adjustResize">

            <!-- "The Files app", as Settings and launchers ask for it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_FILES" />
            </intent-filter>

            <!-- Open a folder: every way apps name one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="resource/folder" />
                <data android:mimeType="inode/directory" />
                <data android:mimeType="x-directory/normal" />
                <data android:mimeType="vnd.android.document/directory" />
                <data android:mimeType="vnd.android.document/root" />
            </intent-filter>

            <!-- The Downloads folder, as the Downloads notification opens it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_DOWNLOADS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Show a file in the viewer: the types it can show. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/json" />
            </intent-filter>

            <!-- Choose a file for another app: attaching, uploading. -->
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

