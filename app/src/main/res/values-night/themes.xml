<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dark parent matters as much as the background colour: inheriting the
      Light theme leaves the framework drawing light-coloured decorations
      behind a black app.
    -->
    <style name="Theme.FileManager" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
